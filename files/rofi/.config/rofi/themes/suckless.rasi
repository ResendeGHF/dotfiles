* {
    bg:       #222222;
    surface:  #222222;
    fg:       #bbbbbb;
    muted:    #777777;
    accent:   #005577;
    selected: #eeeeee;
    border:   #2f2f2f;

    background-color: @bg;
    text-color: @fg;
    font: "Pango:Monospace 11";
}

window {
    width: 580px;
    border: 3px;
    border-color: @border;
    border-radius: 8px;
    padding: 18px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 14px;
}

inputbar {
    children: [ entry, mode-switcher ];
}

mode-switcher {
    spacing: 6px;
}

button {
    width: 90px;
    padding: 8px 14px;
    min-width: 72px;
    border-radius: 4px;
    text-color: @muted;
}

button selected {
    background-color: @accent;
    text-color: @selected;
}

prompt {
    text-color: @muted;
}

entry {
    placeholder: "Search";
    placeholder-color: @muted;
    vertical-align: 0.65;
}

listview {
    lines: 7;
    scrollbar: false;
    spacing: 4px;
    fixed-height: true;
}

element {
    padding: 9px 12px;
    border-radius: 5px;
    spacing: 10px;
}

element selected {
    background-color: @accent;
    text-color: @selected;
}

element-text {
    background-color: inherit;
    text-color: inherit;
}
